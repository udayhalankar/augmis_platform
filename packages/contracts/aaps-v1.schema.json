
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.augmis.com/aaps/v1alpha1/application.schema.json",

  "title": "AUGMIS Application Package Specification",
  "description": "AAPS v1alpha1 application manifest",

  "type": "object",

  "additionalProperties": false,

  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "runtime",
    "services"
  ],

  "properties": {

    "apiVersion": {
      "type": "string",
      "const": "apps.augmis.com/v1alpha1"
    },

    "kind": {
      "type": "string",
      "const": "Application"
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "id",
        "name",
        "version"
      ],

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
        },

        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },

        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },

        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },

    "runtime": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "deploymentMode",
        "buildType"
      ],

      "properties": {

        "deploymentMode": {
          "type": "string",
          "enum": [
            "dedicated"
          ]
        },

        "buildType": {
          "type": "string",
          "enum": [
            "dockerfile",
            "docker-compose",
            "oci"
          ]
        },

        "context": {
          "type": "string"
        },

        "dockerfile": {
          "type": "string"
        },

        "composeFile": {
          "type": "string"
        },

        "image": {
          "type": "string"
        }
      },

      "allOf": [

        {
          "if": {
            "properties": {
              "buildType": {
                "const": "dockerfile"
              }
            }
          },

          "then": {
            "required": [
              "context",
              "dockerfile"
            ]
          }
        },

        {
          "if": {
            "properties": {
              "buildType": {
                "const": "docker-compose"
              }
            }
          },

          "then": {
            "required": [
              "composeFile"
            ]
          }
        },

        {
          "if": {
            "properties": {
              "buildType": {
                "const": "oci"
              }
            }
          },

          "then": {
            "required": [
              "image"
            ]
          }
        }
      ]
    },

    "services": {
      "type": "object",
      "minProperties": 1,

      "additionalProperties": {

        "type": "object",
        "additionalProperties": false,

        "required": [
          "type",
          "port"
        ],

        "properties": {

          "type": {
            "type": "string",
            "enum": [
              "web",
              "api",
              "worker"
            ]
          },

          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },

          "public": {
            "type": "boolean",
            "default": false
          },

          "health": {

            "type": "object",
            "additionalProperties": false,

            "required": [
              "path"
            ],

            "properties": {

              "path": {
                "type": "string",
                "pattern": "^/"
              },

              "intervalSeconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 300
              }
            }
          },

          "resources": {

            "type": "object",
            "additionalProperties": false,

            "properties": {

              "cpu": {
                "type": "string"
              },

              "memory": {
                "type": "string"
              }
            }
          }
        }
      }
    },

    "addons": {

      "type": "object",
      "additionalProperties": false,

      "properties": {

        "database": {

          "type": "object",
          "additionalProperties": false,

          "required": [
            "type"
          ],

          "properties": {

            "type": {
              "type": "string",
              "enum": [
                "postgresql",
                "mysql"
              ]
            },

            "version": {
              "type": "string"
            },

            "storage": {
              "type": "string"
            }
          }
        }
      }
    },

    "authentication": {

      "type": "object",
      "additionalProperties": false,

      "properties": {

        "type": {
          "type": "string",
          "enum": [
            "none",
            "augmis_oidc"
          ]
        },

        "required": {
          "type": "boolean"
        }
      }
    },

    "permissions": {

      "type": "array",

      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]+$"
      },

      "uniqueItems": true
    },

    "lifecycle": {

      "type": "object",
      "additionalProperties": false,

      "properties": {

        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1800
        },

        "rollbackEnabled": {
          "type": "boolean"
        }
      }
    }
  }
}